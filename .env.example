# Required
TELEGRAM_TOKEN=replace_with_telegram_bot_token
OPENROUTER_API_KEY=replace_with_openrouter_key

# Optional AI providers
HF_API_TOKEN=
REPLICATE_API_TOKEN=

# Configurable models
TEXT_MODEL=deepseek/deepseek-chat:free
VISION_MODEL_GEMINI=google/gemini-2.0-flash-lite-preview-02-05:free
VISION_MODEL_NEMOTRON=nvidia/nemotron-nano-12b-v2-vl:free
IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Product settings
FREE_REQUESTS_PER_WEEK=30
ADMINS=
ADMIN_CONTACT=@admin

# Optional local path required by pdf2image on some Windows setups
POPPLER_PATH=
